# Copy this file to .env and fill in real values for your environment.
# Never commit .env or any real secrets (spec NFR5) — .gitignore already
# excludes .env and .env.* while keeping this example file tracked.

# --- Node / server -----------------------------------------------------

# development | production | test — controls prod-only behaviour (e.g. the
# Redis session cache default) and the NODE_ENV=test auth bypass (FR-6).
NODE_ENV=development

PORT=3000
HOST=0.0.0.0

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Session cache (Catbox) ---------------------------------------------

# memory | redis — memory is fine locally; production defaults to redis and
# fails fast if it is unreachable (spec §4: session state must never live on
# the app server in production).
SESSION_CACHE_ENGINE=memory
SESSION_CACHE_NAME=session
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Auth / session (spec §9) --------------------------------------------

# local | dev | test | pre-prod | prod — drives the §9 validation matrix
# (e.g. ENVIRONMENT=prod hard-blocks AUTH_STUB_ENABLED=true, H-8).
ENVIRONMENT=local

# Fake sign-in with predefined canned users, no IdP required (FR-6). Defaults
# to true everywhere except prod, where it is refused even if set true.
# Leave unset locally/in dev; set to false to exercise the real Defra ID flow.
AUTH_STUB_ENABLED=true

# Public base URL this app is reachable at — used to build the OIDC
# redirect_uri and the post-logout redirect. Must be https:// in pre-prod/prod.
AUTH_CALLBACK_BASE_URL=http://localhost:3000

# Cookie signing/encryption key for @hapi/yar sessions — required and must be
# at least 32 characters everywhere except NODE_ENV=test. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Session idle and absolute lifetimes, in minutes (spec §6.4 Option A: session
# lifetime is independent of the Defra ID token's own expiry).
SESSION_IDLE_TTL_MINUTES=240
SESSION_ABSOLUTE_TTL_MINUTES=720

# --- Defra ID (Defra CDP identity provider) ------------------------------
# Required whenever AUTH_STUB_ENABLED=false; leave blank while using the
# stub, or point at the local mock IdP started by `npm run demo`.

# Full .well-known/openid-configuration URL for the target Defra ID
# environment (e.g. CPDEV) — never a hand-assembled endpoint.
DEFRA_ID_DISCOVERY_URL=

# Client ID and secret issued during Defra ID onboarding.
DEFRA_ID_CLIENT_ID=
DEFRA_ID_CLIENT_SECRET=

# Service ID issued during Defra ID onboarding (sent as the non-standard
# `serviceId` authorize param).
DEFRA_ID_SERVICE_ID=

# Send PKCE (code_challenge/code_verifier) params on the authorize/token
# requests — defence in depth on top of the client secret (spec §6.1). Only
# turn off if a target Defra ID environment rejects PKCE parameters.
DEFRA_ID_PKCE_ENABLED=true

# Allowed clock skew, in seconds, when checking id_token exp/nbf.
DEFRA_ID_CLOCK_TOLERANCE_SECONDS=60

# How long, in seconds, a fetched .well-known document is cached before being
# re-fetched (stale copy served on refresh failure).
DEFRA_ID_DISCOVERY_CACHE_TTL_SECONDS=3600

# Enables refresh-token handling (Option B, spec §6.4) — a roadmap extension,
# not used by v1. Leave false.
DEFRA_ID_REFRESH_ENABLED=false
