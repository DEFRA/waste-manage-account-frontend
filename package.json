{
  "name": "waste-manage-account-frontend",
  "version": "0.1.0",
  "description": "GOV.UK frontend for the waste management account service (Hello World bootstrap)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon --ext js,njk,json --legacy-watch --watch ./src --exec \"node --env-file-if-exists=.env\" ./src",
    "start": "NODE_ENV=production node --env-file-if-exists=.env .",
    "build:frontend": "vite build",
    "demo": "run-s build:frontend demo:start",
    "demo:start": "node --env-file-if-exists=.env scripts/demo.js",
    "test": "TZ=UTC NODE_ENV=test vitest run --coverage",
    "test:watch": "TZ=UTC NODE_ENV=test vitest",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:scss": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,md}\"",
    "git:hooks": "husky"
  },
  "license": "OGL-UK-3.0",
  "overrides": {
    "fast-uri": "3.1.4"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@hapi/catbox": "12.1.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "govuk-frontend": "6.3.0",
    "hapi-pino": "13.0.0",
    "jose": "6.2.3",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "undici": "8.8.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.2",
    "@vitest/coverage-v8": "4.1.8",
    "axe-core": "4.12.1",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.2",
    "sass-embedded": "1.100.0",
    "stylelint": "16.26.1",
    "stylelint-config-gds": "2.0.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
