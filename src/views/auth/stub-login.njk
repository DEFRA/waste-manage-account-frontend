{% extends "layouts/page.njk" %}

{% block pageTitle %}Sign in (stub mode) – {{ serviceName }} – GOV.UK{% endblock %}

{% block content %}
  <h1 class="govuk-heading-xl">Sign in (stub mode)</h1>
  <p class="govuk-body">No real Defra ID sign-in is used here. Choose a test user to continue.</p>

  <form method="post" action="/auth/stub/login">
    <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
    <input type="hidden" name="returnTo" value="{{ returnTo }}">

    <div class="govuk-form-group">
      <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
          Test users
        </legend>
        <div class="govuk-radios" data-module="govuk-radios">
          {% for user in users %}
            <div class="govuk-radios__item">
              <input class="govuk-radios__input" id="user-{{ user.id }}" name="userId" type="radio" value="{{ user.id }}"{% if loop.first %} checked{% endif %}>
              <label class="govuk-label govuk-radios__label" for="user-{{ user.id }}">
                {{ user.profile.name }} – {{ user.description }}
              </label>
            </div>
          {% endfor %}
        </div>
      </fieldset>
    </div>

    <button class="govuk-button" data-module="govuk-button" type="submit">
      Sign in
    </button>
  </form>

  {% if defraIdAvailable %}
    <p class="govuk-body">
      <a class="govuk-link" href="/auth/defra-id">Sign in with Defra ID</a>
    </p>
  {% endif %}
{% endblock %}
